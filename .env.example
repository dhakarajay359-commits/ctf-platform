# Copy this file to .env and fill in real values before running.

# Password required to access /admin.html — pick something long and random.
ADMIN_PASSWORD=change-me-to-something-strong

# Used to sign session cookies — pick a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on (most hosts set this automatically).
PORT=3000

# CTF Start and End times (can also be set via Admin Dashboard)
# CTF_START_TIME=
# CTF_END_TIME=

# Discord Webhook Integration for First Bloods & Anomalies
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

NODE_ENV=production
